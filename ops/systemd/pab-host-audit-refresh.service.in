# SOURCE TEMPLATE ONLY: NOT INSTALLED OR ENABLED.
# Local operator must confirm and substitute ALL four placeholders after
# checking the pinned collector SHA, trusted UID, Python path and snapshot mount.
# The two existing home-backed resources are mapped into /run for this service;
# ProtectHome=yes continues hiding every other home path.
# No new Docker socket permissions, credentials, image or Compose changes.
[Unit]
Description=Personal AI Brain private host snapshot refresh (operator-owned)
After=local-fs.target
ConditionPathExists=@PINNED_COLLECTOR_FILE@
ConditionPathIsDirectory=@EXISTING_SNAPSHOT_DIR@

[Service]
Type=oneshot
User=@APPROVED_COLLECTOR_USER@
ExecStart=@APPROVED_PYTHON@ -I -B /run/pab-host-audit-collector.py collect --output /run/pab-host-audit-output/snapshot.json
WorkingDirectory=/
UMask=0077
TimeoutStartSec=25s
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# systemd manager resolves the sources on the host. Destinations stay outside
# /home; never use ProtectHome=no or open the entire home tree.
BindReadOnlyPaths=@PINNED_COLLECTOR_FILE@:/run/pab-host-audit-collector.py
BindPaths=@EXISTING_SNAPSHOT_DIR@:/run/pab-host-audit-output
ReadWritePaths=/run/pab-host-audit-output
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
